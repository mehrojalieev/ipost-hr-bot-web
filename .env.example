# Bot token (Mini App initData imzosini tekshirish uchun — bot bilan bir xil)
BOT_TOKEN=123456:ABC-DEF...

# HR/admin Telegram ID lari (vergul bilan). Faqat shular panelga kira oladi.
# O'z ID ingizni bilish: botga /myid yozing (yoki @userinfobot).
HR_TELEGRAM_IDS=123456789,987654321

# Development rejimida Telegram tekshiruvini o'tkazib yuborish (brauzerda ochib ko'rish uchun).
# Productionda ALBATTA "false" bo'lsin!
NEXT_PUBLIC_DEV_BYPASS=true
