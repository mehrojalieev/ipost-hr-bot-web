// iPOST HR — ma'lumotlar bazasi sxemasi (PostgreSQL)
// Bot va panel shu bitta bazadan foydalanadi (panel API orqali).
// Migratsiyalarni faqat SHU loyiha (panel) boshqaradi — yagona manba.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  new
  reviewing
  accepted
  rejected
}

enum MessageStatus {
  new
  answered
}

// Vakansiya — 2 tilli (uz/ru). Har til uchun kontent JSON'da saqlanadi:
//   { title, department, employment, salary, location, description, requirements[] }
model Vacancy {
  id        String   @id
  emoji     String   @default("💼")
  active    Boolean  @default(true)
  uz        Json
  ru        Json
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([active])
  @@index([createdAt])
}

model Application {
  id           String            @id @default(cuid())
  vacancyId    String
  vacancyTitle String // nomzod tilidagi vakansiya nomi (snapshot)
  name         String
  phone        String
  age          String            @default("")
  experience   String            @default("")
  status       ApplicationStatus @default(new)

  // Telegram — xabar yuborish uchun
  telegramId   String            @default("") // raqamli chat id (xabar yuborish uchun)
  telegramUser String            @default("") // @username (ko'rsatish uchun)
  lang         String            @default("uz") // "uz" | "ru" — xabar tili

  // Rezyume (ixtiyoriy)
  hasResume    Boolean           @default(false)
  resumeFileId String? // Telegram file_id (zaxira / qayta yuklash uchun)
  resumeType   String? // "document" | "photo"
  resumeName   String? // asl fayl nomi
  resumeMime   String? // MIME turi
  resumePath   String? // serverdagi saqlangan yo'l (uploads/…)

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt

  @@index([status])
  @@index([vacancyId])
  @@index([createdAt])
  @@index([telegramId])
}

model Message {
  id           String        @id @default(cuid())
  name         String
  telegramUser String        @default("")
  topic        String        @default("")
  text         String
  status       MessageStatus @default(new)
  createdAt    DateTime      @default(now())

  @@index([status])
  @@index([createdAt])
}
