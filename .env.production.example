# ============================================================
#  iPOST HR — PANEL (.env.production)
#  Serverda shu faylni ".env" (yoki ".env.production") deb nusxalang
#  va HAQIQIY qiymatlarni to'ldiring. Bu faylni Git'ga QO'YMANG.
# ============================================================

# --- Ma'lumotlar bazasi (server ustidagi PostgreSQL) ---
# Format: postgresql://FOYDALANUVCHI:PAROL@localhost:5432/ipost_hr
DATABASE_URL=postgresql://ipost:CHANGE_ME_STRONG_PASSWORD@localhost:5432/ipost_hr

# --- Telegram bot tokeni (@BotFather) ---
# Panel nomzodlarga xabar yuborish uchun ishlatadi (bot bilan AYNAN bir xil token).
BOT_TOKEN=CHANGE_ME_BOT_TOKEN

# --- Bot <-> Panel maxfiy kaliti ---
# Bot shu kalit bilan panel API'siga murojaat qiladi.
# Bot .env dagi BOT_API_KEY bilan AYNAN BIR XIL bo'lishi SHART.
# Kuchli tasodifiy qiymat yarating:  openssl rand -hex 32
BOT_API_KEY=CHANGE_ME_LONG_RANDOM_SECRET

# --- HR ruxsati ---
# Panelga kira oladigan HR Telegram ID lari (vergul bilan).
HR_TELEGRAM_IDS=8424205007,1755661523

# --- MUHIM: productionda HAR DOIM false ---
# true bo'lsa panel HAMMAGA ochiq bo'lib qoladi (faqat dev uchun).
NEXT_PUBLIC_DEV_BYPASS=false
